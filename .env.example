# Copy to .env, fill in the values, then load with:  set -a; source .env; set +a
# Never commit .env (it is in .gitignore).

# Service principal that is a member of the Fabric workspace
FABRIC_TENANT_ID=<tenant-guid>
FABRIC_CLIENT_ID=<app-client-guid>
FABRIC_CLIENT_SECRET=<secret from Key Vault>

# Azure OpenAI (Azure Government uses the .azure.us host)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.us/
AZURE_OPENAI_API_KEY=<key from Key Vault>

# Optional (defaults shown)
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# FABRIC_WORKSPACE=CQD
# FABRIC_LAKEHOUSE=cqd_lh
# ONELAKE_HOST=high-onelake.dfs.fabric.microsoft.us
# LAKEHOUSE_SCHEMA=dbo
# SALES_TABLE=dbo/sales
# CHAT_PORT=8000
# CHAT_REFRESH_SECONDS=300

# Only for agent/agent.py (SQL analytics endpoint)
# FABRIC_SQL_SERVER=<id>.high-datawarehouse.fabric.microsoft.us
# FABRIC_DATABASE=<lakehouse name>
